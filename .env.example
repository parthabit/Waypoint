# Copy this file to .env.local and fill in your free API key(s).
# The app works without any keys (search, weather, and nearby-places all
# use keyless free APIs) — but route optimization will fall back to
# straight-line distance estimates instead of real road routing until you
# add an OpenRouteService key below.

# --- OpenRouteService (free tier: 2,000 requests/day) -----------------
# 1. Sign up at https://openrouteservice.org/dev/#/signup
# 2. Create a token (choose the "Standard" free plan)
# 3. Paste it here
ORS_API_KEY=

# --- Optional: Unsplash (only needed if you wire up real destination
# photos later — the home page currently uses a few static Unsplash URLs
# that need no key) -----------------------------------------------------
UNSPLASH_ACCESS_KEY=
